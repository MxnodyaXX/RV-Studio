# Public Supabase project settings (safe for the browser; access is enforced by RLS).
# Find them in Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service-role / secret key in any VITE_* variable — it would be shipped to the browser.

# --- Integration tests only (tests/integration). Use a NON-production project. ---
# Do not set these in Vercel.
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_NON_ADMIN_EMAIL=
# TEST_NON_ADMIN_PASSWORD=
